{
  "name": "stanislavmatzke-web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "content": "node scripts/build-content.mjs",
    "start": "node scripts/build-content.mjs --drafts && ng serve --open",
    "build": "node scripts/build-content.mjs && ng build",
    "build:drafts": "node scripts/build-content.mjs --drafts && ng build",
    "watch": "node scripts/build-content.mjs --drafts && ng build --watch --configuration development",
    "test": "node --test \"scripts/**/*.test.mjs\""
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.26",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.0",
    "typescript": "~5.9.2"
  }
}
